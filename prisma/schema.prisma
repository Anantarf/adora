generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x", "rhel-openssl-3.0.x", "debian-openssl-1.1.x", "rhel-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
}

model homebase {
  id          String    @id @default(cuid())
  name        String    @unique
  address     String
  phone       String?
  description String?   
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  groups             group[]
  events             event[]
  preferredByPlayers player[] @relation("PreferredHomebase")
  registrations      registration[]

  @@map("Homebase")
}

model account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? 
  access_token      String? 
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? 
  session_state     String?
  user              user    @relation(fields: [userId], references: [id], onDelete: Cascade, map: "Account_userId_fkey")

  @@unique([provider, providerAccountId], map: "Account_provider_providerAccountId_key")
  @@index([userId], map: "Account_userId_idx")
}

model attendance {
  id        String            @id @default(cuid())
  date      DateTime
  status    attendance_status
  note      String?           
  playerId  String
  eventId   String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @default(now()) @updatedAt

  player    player            @relation(fields: [playerId], references: [id], onDelete: Cascade, map: "Attendance_playerId_fkey")
  event     event?            @relation(fields: [eventId], references: [id], onDelete: SetNull, map: "Attendance_eventId_fkey")

  @@unique([playerId, date], map: "Attendance_playerId_date_key")
  @@index([eventId], map: "Attendance_eventId_idx")
}

model auditlog {
  id          String   @id @default(cuid())
  action      String
  targetTable String
  recordId    String?
  details     Json?
  timestamp   DateTime @default(now())
  userId      String?
  user        user?    @relation(fields: [userId], references: [id], map: "AuditLog_userId_fkey")

  @@index([userId], map: "AuditLog_userId_idx")
  @@index([timestamp])
}

model certificate {
  id         String   @id @default(cuid())
  title      String
  fileUrl    String
  uploadedAt DateTime @default(now())
  playerId   String
  player     player   @relation(fields: [playerId], references: [id], onDelete: Cascade, map: "Certificate_playerId_fkey")

  @@index([playerId], map: "Certificate_playerId_idx")
  @@index([fileUrl], map: "Certificate_fileUrl_idx")
}

model event {
  id          String     @id @default(cuid())
  title       String
  description String?    
  date        DateTime
  type        event_type @default(LATIHAN)
  location    String?
  homebaseId  String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  eventGroups eventGroup[]
  homebase    homebase?    @relation(fields: [homebaseId], references: [id], onDelete: SetNull, map: "Event_homebaseId_fkey")
  attendances attendance[]

  @@index([homebaseId], map: "Event_homebaseId_idx")
  @@index([date], map: "Event_date_idx")
  @@map("Event")
}

model eventGroup {
  id      String @id @default(cuid())
  eventId String
  groupId String

  event   event  @relation(fields: [eventId], references: [id], onDelete: Cascade, map: "EventGroup_eventId_fkey")
  group   group  @relation(fields: [groupId], references: [id], onDelete: Cascade, map: "EventGroup_groupId_fkey")

  @@unique([eventId, groupId], map: "EventGroup_eventId_groupId_key")
  @@index([eventId], map: "EventGroup_eventId_idx")
  @@index([groupId], map: "EventGroup_groupId_idx")
  @@map("EventGroup")
}

model group {
  id          String        @id @default(cuid())
  name        String        @unique(map: "Group_name_key")
  category    group_category @default(KELOMPOK_UMUR)
  targetKu    Int?
  schoolLevel String?
  description String?       
  homebaseId  String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  homebase    homebase?     @relation(fields: [homebaseId], references: [id], onDelete: SetNull, map: "Group_homebaseId_fkey")
  coachAssignment coachAssignment?
  eventGroups eventGroup[]
  player      player[]
  reportArchive reportArchive[]

  @@index([homebaseId], map: "Group_homebaseId_idx")
  @@map("Group")
}

model player {
  id                  String        @id @default(cuid())
  name                String
  firstName           String
  lastName            String        @default("")
  dateOfBirth         DateTime
  placeOfBirth        String?
  gender              String?
  religion            String?
  weight              String?
  height              String?
  schoolOrigin        String?
  address             String?
  addressLine1        String?
  addressLine2        String?
  city                String?
  province            String?
  postalCode          String?
  ktpAddress          String?
  email               String?
  phoneNumber         String?
  medicalHistory      String?       
  hasMedicalCondition Boolean       @default(false)
  medicalConditionDetail String?
  instagram           String?
  parentName          String?
  parentAddress       String?
  parentPhoneNumber   String?
  photoUrl            String?
  signatureUrl        String?
  isDeleted           Boolean       @default(false)
  groupId             String?
  parentId            String?
  preferredHomebaseId String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  attendance        attendance[]
  certificate       certificate[]
  group             group?        @relation(fields: [groupId], references: [id], onDelete: SetNull, map: "Player_groupId_fkey")
  reportArchive     reportArchive[]
  user              user?         @relation(fields: [parentId], references: [id], onDelete: SetNull, map: "Player_parentId_fkey")
  preferredHomebase homebase?     @relation("PreferredHomebase", fields: [preferredHomebaseId], references: [id], onDelete: SetNull, map: "Player_preferred_homebaseId_fkey")
  statistic         statistic[]

  @@index([groupId], map: "Player_groupId_idx")
  @@index([parentId], map: "Player_parentId_idx")
  @@index([preferredHomebaseId], map: "Player_preferred_homebaseId_idx")
  @@index([isDeleted], map: "Player_isDeleted_idx")
  @@index([photoUrl], map: "Player_photoUrl_idx")
  @@index([signatureUrl], map: "Player_signatureUrl_idx")
  @@unique([name, dateOfBirth, groupId], map: "Player_name_dateOfBirth_groupId_key")
  @@map("Player")
}

model session {
  id           String   @id @default(cuid())
  sessionToken String   @unique(map: "Session_sessionToken_key")
  userId       String
  expires      DateTime
  user         user     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "Session_userId_fkey")

  @@index([userId], map: "Session_userId_idx")
}

model evaluationPeriod {
  id        String      @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime
  isActive  Boolean     @default(false)
  createdAt DateTime    @default(now())

  reportArchive reportArchive[]
  statistic statistic[]

  @@map("EvaluationPeriod")
}

model coachProfile {
  id           String            @id @default(cuid())
  userId       String            @unique(map: "CoachProfile_userId_key")
  fullName     String
  placeOfBirth String?
  dateOfBirth  DateTime?
  gender       String?
  photoUrl     String?
  licenseUrl   String?
  isDeleted    Boolean           @default(false)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  assignments  coachAssignment[]
  user         user              @relation(fields: [userId], references: [id], onDelete: Cascade, map: "CoachProfile_userId_fkey")

  @@index([isDeleted], map: "CoachProfile_isDeleted_idx")
  @@map("CoachProfile")
}

model coachAssignment {
  id             String       @id @default(cuid())
  coachProfileId String
  groupId        String       @unique(map: "CoachAssignment_groupId_key")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  coachProfile coachProfile @relation(fields: [coachProfileId], references: [id], onDelete: Cascade, map: "CoachAssignment_coachProfileId_fkey")
  group        group        @relation(fields: [groupId], references: [id], onDelete: Cascade, map: "CoachAssignment_groupId_fkey")

  @@index([coachProfileId], map: "CoachAssignment_coachProfileId_idx")
  @@map("CoachAssignment")
}

model reportArchive {
  id           String               @id @default(cuid())
  playerId     String
  periodId     String
  groupId      String?
  fileUrl      String
  status       report_archive_status @default(DRAFT)
  releasedAt   DateTime?
  uploadedById String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  group      group?            @relation(fields: [groupId], references: [id], onDelete: SetNull, map: "ReportArchive_groupId_fkey")
  period     evaluationPeriod  @relation(fields: [periodId], references: [id], onDelete: Cascade, map: "ReportArchive_periodId_fkey")
  player     player            @relation(fields: [playerId], references: [id], onDelete: Cascade, map: "ReportArchive_playerId_fkey")
  uploadedBy user?             @relation(fields: [uploadedById], references: [id], onDelete: SetNull, map: "ReportArchive_uploadedById_fkey")

  @@unique([playerId, periodId], map: "ReportArchive_playerId_periodId_key")
  @@index([groupId], map: "ReportArchive_groupId_idx")
  @@index([periodId], map: "ReportArchive_periodId_idx")
  @@index([status], map: "ReportArchive_status_idx")
  @@index([uploadedById], map: "ReportArchive_uploadedById_idx")
  @@map("ReportArchive")
}

model statistic {
  id          String           @id @default(cuid())
  date        DateTime
  metricsJson Json
  status      statistic_status @default(Draft)
  playerId    String
  periodId    String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @default(now()) @updatedAt

  player  player            @relation(fields: [playerId], references: [id], onDelete: Cascade, map: "Statistic_playerId_fkey")
  period  evaluationPeriod? @relation(fields: [periodId], references: [id], onDelete: SetNull, map: "Statistic_periodId_fkey")
  history statisticHistory[]

  @@unique([playerId, periodId], map: "Statistic_playerId_periodId_key")
  @@index([status])
  @@index([periodId], map: "Statistic_periodId_idx")
}

model statisticHistory {
  id          String           @id @default(cuid())
  statisticId String
  metricsJson Json
  status      statistic_status
  editedAt    DateTime         @default(now())
  editedBy    String?

  statistic statistic @relation(fields: [statisticId], references: [id], onDelete: Cascade, map: "StatisticHistory_statisticId_fkey")
  user      user?     @relation(fields: [editedBy], references: [id], onDelete: SetNull, map: "StatisticHistory_editedBy_fkey")

  @@index([statisticId], map: "StatisticHistory_statisticId_idx")
  @@map("StatisticHistory")
}

model user {
  id                 String     @id @default(cuid())
  name               String?
  email              String?    @unique(map: "User_email_key")
  emailVerified      DateTime?
  image              String?
  username           String?    @unique(map: "User_username_key")
  password           String?
  role               user_role  @default(PARENT)
  isDeleted          Boolean    @default(false)
  mustChangePassword Boolean    @default(false)

  account          account[]
  auditlog         auditlog[]
  coachProfile     coachProfile?
  player           player[]
  reportArchive    reportArchive[]
  session          session[]
  statisticHistory statisticHistory[]

  @@index([isDeleted], map: "User_isDeleted_idx")
}

model verificationtoken {
  identifier String
  token      String   @unique(map: "VerificationToken_token_key")
  expires    DateTime

  @@unique([identifier, token], map: "VerificationToken_identifier_token_key")
}

model registration {
  id          String              @id @default(cuid())
  playerName  String
  phone       String
  email       String?
  ageGroup    String
  homebaseId  String
  status      registration_status @default(PENDING)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  homebase homebase @relation(fields: [homebaseId], references: [id], map: "Registration_homebaseId_fkey")

  @@index([homebaseId], map: "Registration_homebaseId_idx")
  @@index([status], map: "Registration_status_idx")
  @@map("Registration")
}

model clubSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   
  updatedAt DateTime @updatedAt

  @@map("ClubSetting")
}

model rateLimitBucket {
  id        String   @id @default(cuid())
  namespace String
  key       String
  count     Int
  resetAt   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([namespace, key], map: "RateLimitBucket_namespace_key_key")
  @@index([resetAt], map: "RateLimitBucket_resetAt_idx")
  @@map("RateLimitBucket")
}

model webVitalEvent {
  id             String   @id @default(cuid())
  metricId       String?
  name           String
  value          Float
  delta          Float
  rating         String
  navigationType String?
  pathname       String
  createdAt      DateTime @default(now())

  @@index([createdAt], map: "WebVitalEvent_createdAt_idx")
  @@index([name, rating], map: "WebVitalEvent_name_rating_idx")
  @@index([pathname], map: "WebVitalEvent_pathname_idx")
  @@map("WebVitalEvent")
}

model operationalEvent {
  id         String               @id @default(cuid())
  severity   operational_severity
  source     String
  message    String
  statusCode Int?
  durationMs Int?
  fingerprint String?
  metadata   Json?
  createdAt  DateTime             @default(now())

  @@index([createdAt], map: "OperationalEvent_createdAt_idx")
  @@index([severity, createdAt], map: "OperationalEvent_severity_createdAt_idx")
  @@index([source, createdAt], map: "OperationalEvent_source_createdAt_idx")
  @@index([fingerprint], map: "OperationalEvent_fingerprint_idx")
  @@map("OperationalEvent")
}

enum attendance_status {
  HADIR
  IZIN
  SAKIT
  ALPA
}

enum user_role {
  ADMIN
  COACH
  PARENT
}

enum report_archive_status {
  DRAFT
  RELEASED
}

enum event_type {
  LATIHAN
  PERTANDINGAN
  SPARING
  EVALUASI
  KHUSUS
}

enum statistic_status {
  Draft
  Published
}

enum registration_status {
  PENDING
  REVIEWED
  COMPLETED
}

enum group_category {
  SEKOLAH
  KELOMPOK_UMUR
}

enum operational_severity {
  INFO
  WARN
  ERROR
}
